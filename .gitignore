# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE settings
.idea/
.vscode/
*.swp
*.swo

# Local environment and secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Angular / Node.js dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/

# Angular generated artifacts and test coverage
dist/
build/
coverage/

# Flutter and Dart generated files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
**/build/

# Android and iOS local files generated by Flutter tooling
**/android/local.properties
**/android/key.properties
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh

# Language caches
__pycache__/
*.py[cod]
