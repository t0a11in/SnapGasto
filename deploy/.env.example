# Copia este archivo como deploy/.env EN EL SERVIDOR (nunca en el repositorio).

# Dominio público (sin https://). Su DNS debe apuntar al servidor.
DOMAIN=snapgasto.tu-dominio.cl

# Contraseña de SQL Server (sa): mínimo 8 caracteres, mayúsculas, minúsculas, números y símbolos.
# Usa una NUEVA: no reutilices la de desarrollo.
DB_PASSWORD=
DB_NAME=snap_gastos
# Edición de SQL Server: Express es gratuita para producción (hasta 10 GB por base).
MSSQL_PID=Express

# Secreto JWT: aleatorio, 32+ caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
JWT_MAX_SESSION_HOURS=168

# Correo que se promueve a ADMIN al iniciar (la cuenta debe existir).
APP_BOOTSTRAP_ADMIN_EMAIL=

# Las completa el pipeline en cada despliegue; no hace falta tocarlas.
IMAGE_PREFIX=ghcr.io/t0a11in
IMAGE_TAG=latest
