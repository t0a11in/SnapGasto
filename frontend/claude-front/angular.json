{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "claude-front": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "icon-nodes.json",
                "input": "node_modules/lucide-static",
                "output": "icons/lucide"
              },
              {
                "glob": "tabler-nodes-*.json",
                "input": "node_modules/@tabler/icons",
                "output": "icons/tabler"
              },
              {
                "glob": "bootstrap-icons.svg",
                "input": "node_modules/bootstrap-icons",
                "output": "icons/bootstrap"
              },
              {
                "glob": "bootstrap-icons.json",
                "input": "node_modules/bootstrap-icons/font",
                "output": "icons/bootstrap"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "polyfills": [
              "@angular/localize/init"
            ],
            "allowedCommonJsDependencies": [
              "feather-icons"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "define": {
                "ngApiBaseUrl": "'/api'"
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "claude-front:build:production"
            },
            "development": {
              "buildTarget": "claude-front:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "karma",
            "runnerConfig": "karma.conf.js",
            "tsConfig": "tsconfig.spec.json",
            "browsers": [
              "Chrome"
            ]
          }
        }
      }
    }
  }
}
