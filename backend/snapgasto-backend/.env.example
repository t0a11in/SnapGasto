# Variables para el stack local de Docker Compose. DB_PASSWORD es la contraseña
# de la cuenta sa de SQL Server y se utiliza también desde DBeaver.
DB_PORT=1434
DB_NAME=snap_gastos
DB_USER=sa
# SQL Server exige una contraseña de al menos 8 caracteres y compleja.
DB_PASSWORD=replace-with-a-strong-local-sql-server-password

# Usar una clave aleatoria de al menos 32 caracteres; no reutilizar una contraseña.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=120
# La cuenta que se registre con este correo recibirá el rol ADMIN; también promueve una cuenta existente al iniciar.
APP_BOOTSTRAP_ADMIN_EMAIL=
# Para activar el acceso Google/Firebase, revisar compose.firebase.example.yaml.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Opcional: usado únicamente con compose.debug.yaml.
DEBUG_PORT=5005
DEBUG_SUSPEND=n
